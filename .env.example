# Copy to .env and adjust. Every value has a working default, so this file is
# optional for a first run on a trusted machine.

# --- Time zone -------------------------------------------------------------
# Used for "today" (verified / tested dates). IANA name, e.g. Europe/London.
TZ=UTC

# --- Web UI ----------------------------------------------------------------
# The only published port. The API itself is never exposed.
FRONTEND_PORT=3000

# --- PostgreSQL ------------------------------------------------------------
# The database is not published outside the Compose network. Change the
# password anyway; keep it URL-safe (letters, digits, - and _) because it is
# embedded in the connection URL.
POSTGRES_USER=hoardware
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hoardware

# --- Login (single user) ---------------------------------------------------
# Set a password (or, better, a hash) to require sign-in. With neither set, anyone
# who can reach the app can use it. Make a hash with:
#   docker compose run --rm --no-deps backend python -m app.cli hash-password
# Changing the password signs every session out.
AUTH_USERNAME=admin
AUTH_PASSWORD=
AUTH_PASSWORD_HASH=
AUTH_SESSION_DAYS=30
# auto: the cookie is Secure when the reverse proxy says the request was https.
AUTH_COOKIE_SECURE=auto

# --- Photo and file storage ------------------------------------------------
# Photos and downloads (manuals, drivers...) are stored outside the database.
# auto (default): S3 when S3_BUCKET is set below, otherwise the "photos" volume.
# Or force one: local / s3.
STORAGE_BACKEND=auto
MAX_UPLOAD_BYTES=20971520
# Largest download file (manual, driver, tool...), in bytes. Default 1 GB.
MAX_FILE_BYTES=1073741824

# S3 settings, used when STORAGE_BACKEND is s3, or auto with a bucket set (and as defaults for backups).
# Objects are stored as <S3_PREFIX>items/<item id>/photos/... and .../files/...
# (leave S3_PREFIX empty for the bucket root). Leave S3_ENDPOINT_URL empty for AWS S3; set it for MinIO, Backblaze B2, R2...
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_BUCKET=
S3_PREFIX=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true = http://host/bucket/key (MinIO and most self-hosted); false = bucket.host
S3_FORCE_PATH_STYLE=true

# --- Database backups ------------------------------------------------------
# Local dumps always go to the "backups" volume. Set BACKUP_S3_BUCKET to also
# upload each dump to S3. Unset BACKUP_S3_* connection values fall back to S3_*.
# Scheduled backups run with: docker compose --profile backup up -d
BACKUP_RETENTION_COUNT=14
BACKUP_INTERVAL_HOURS=24
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=backups/
BACKUP_S3_ENDPOINT_URL=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# --- Reference datasets ----------------------------------------------------
# Host folder mounted read-only at /reference-data in the backend container.
REFERENCE_DATA_DIR=./reference-data
